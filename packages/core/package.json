{
  "name": "@erris/core",
  "version": "1.0.1",
  "description": "Core runtime error contracts for JavaScript and TypeScript.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "package:check": "publint run --strict --pack npm . && attw --pack . --profile esm-only"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sreeragpariyarath/erris.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/sreeragpariyarath/erris#readme",
  "bugs": {
    "url": "https://github.com/sreeragpariyarath/erris/issues"
  }
}

{
  "name": "@erris/http",
  "version": "1.0.1",
  "description": "HTTP transport rendering for Erris errors.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "package:check": "publint run --strict --pack npm . && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@erris/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
